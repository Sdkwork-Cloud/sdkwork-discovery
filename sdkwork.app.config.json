{
  "schemaVersion": 3,
  "kind": "sdkwork.app",
  "app": {
    "key": "sdkwork-discovery",
    "name": "SDKWork Discovery",
    "displayName": "SDKWork Discovery",
    "description": "SDKWork service discovery and runtime configuration control plane.",
    "vendor": "SDKWork",
    "officialWebsiteUrl": "https://sdkwork.com/apps/sdkwork-discovery",
    "supportUrl": "https://sdkwork.com/support",
    "privacyPolicyUrl": "https://sdkwork.com/privacy",
    "termsOfServiceUrl": "https://sdkwork.com/terms",
    "iconUrl": "https://cdn.sdkwork.com/apps/sdkwork-discovery/assets/icon-1024.png",
    "appType": "APP_SERVICE",
    "versionSource": "Cargo.toml",
    "identifiers": {
      "packageName": null,
      "bundleId": null,
      "desktopAppId": null,
      "containerImage": "registry.sdkwork.com/apps/sdkwork-discovery"
    }
  },
  "backend": {
    "profileKey": "backend-root-admin",
    "ownerMode": "tenant",
    "grantMode": "current",
    "platform": "WEB",
    "appId": null,
    "organizationId": null
