      "SERVER",
      "CONTAINER"
    ],
    "installPlatforms": [
      "SERVER",
      "CONTAINER"
    ],
    "defaultPackageId": "linux-x64-server-tar-gz",
    "storeUrl": "https://sdkwork.com/apps/sdkwork-discovery",
    "stores": [],
    "config": {
      "workspaceRoot": ".",
      "framework": "rust-tonic",
      "managedBy": "sdkwork-discovery"
    }
  },
  "environments": {
    "development": {
      "accessUrl": "grpc://127.0.0.1:19090",
      "deployUrl": "grpc://127.0.0.1:19090",
      "deployEnv": "dev"
    },
    "test": {
      "accessUrl": "grpc://127.0.0.1:19090",
      "deployUrl": "grpc://127.0.0.1:19090",
      "deployEnv": "test"
    },
    "production": {
      "accessUrl": "https://discovery.sdkwork.com",
      "deployUrl": "https://discovery.sdkwork.com",
      "deployEnv": "production"
