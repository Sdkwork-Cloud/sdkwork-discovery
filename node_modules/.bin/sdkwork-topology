#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/e/sdkwork-space/sdkwork-discovery/node_modules/.pnpm/@sdkwork+app-topology@file+..+sdkwork-app-topology/node_modules/@sdkwork/app-topology/node_modules:/mnt/e/sdkwork-space/sdkwork-discovery/node_modules/.pnpm/@sdkwork+app-topology@file+..+sdkwork-app-topology/node_modules:/mnt/e/sdkwork-space/sdkwork-discovery/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/e/sdkwork-space/sdkwork-discovery/node_modules/.pnpm/@sdkwork+app-topology@file+..+sdkwork-app-topology/node_modules/@sdkwork/app-topology/node_modules:/mnt/e/sdkwork-space/sdkwork-discovery/node_modules/.pnpm/@sdkwork+app-topology@file+..+sdkwork-app-topology/node_modules:/mnt/e/sdkwork-space/sdkwork-discovery/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@sdkwork/app-topology/scripts/sdkwork-topology.mjs" "$@"
else
  exec node  "$basedir/../@sdkwork/app-topology/scripts/sdkwork-topology.mjs" "$@"
fi
