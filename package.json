{
  "name": "sdkwork-discovery-workspace",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@sdkwork/app-topology": "workspace:*"
  },
  "scripts": {
    "stop": "pnpm exec sdkwork-app stop",
    "dev": "pnpm dev:standalone",
    "dev:cloud": "pnpm exec sdkwork-app dev --deployment-profile cloud",
    "build": "pnpm exec sdkwork-app build",
    "test": "pnpm exec sdkwork-app test",
    "check": "pnpm exec sdkwork-app check",
    "verify": "pnpm exec sdkwork-app verify",
    "clean": "pnpm exec sdkwork-app clean",
    "format": "cargo fmt --all",
    "format:check": "cargo fmt --all -- --check",
    "release:package": "node scripts/package-server.mjs package",
    "release:validate": "node scripts/package-server.mjs validate",
    "sdk:generate": "npx --yes @bufbuild/buf generate --template sdks/sdkwork-discovery-rpc-sdk/sdkwork-discovery-rpc-sdk-typescript/buf.gen.yaml proto",
    "topology:validate": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json",
    "topology:matrix": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs print-matrix --root . --spec specs/topology.spec.json --profile all",
    "topology:plan": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs plan --root . --spec specs/topology.spec.json",
    "test:topology-baggage": "node --test scripts/dev/sdkwork-discovery-topology-baggage.test.mjs",
    "test:package-contract": "node --test scripts/dev/package-server-contract.test.mjs",
    "test:sdk-typescript-helpers": "node --test scripts/dev/sdk-typescript-sdk-helpers.test.mjs",
    "test:docs-runbooks": "node --test scripts/dev/docs-runbooks-contract.test.mjs",
    "test:docs-canon": "node --test scripts/dev/docs-canon-contract.test.mjs",
    "test:topology-validate": "pnpm run topology:validate",
    "verify:docs": "node ../sdkwork-specs/tools/check-repository-docs-standard.mjs --root .",
    "verify:rpc-proto": "node scripts/verify-rpc-proto.mjs",
    "verify:sdk-rust": "cargo test --manifest-path sdks/sdkwork-discovery-rpc-sdk/sdkwork-discovery-rpc-sdk-rust/Cargo.toml",
    "verify:sdk-typescript": "pnpm --dir sdks/sdkwork-discovery-rpc-sdk/sdkwork-discovery-rpc-sdk-typescript install && pnpm --dir sdks/sdkwork-discovery-rpc-sdk/sdkwork-discovery-rpc-sdk-typescript check",
    "db:materialize:contract": "node ../sdkwork-specs/tools/materialize-database-contract-from-baseline.mjs --root . --baseline database/ddl/baseline/postgres/0001_discovery_baseline.sql --module-id discovery --owner discovery-platform --prefixes discovery_ --engines postgres,sqlite",
    "db:validate": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "db:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan",
    "db:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init",
    "db:migrate": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . migrate",
    "db:seed": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . seed",
    "db:status": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . status",
    "db:drift": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift",
    "db:drift:check": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift-check",
    "db:bootstrap": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . bootstrap",
    "test:contract:database": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "db:postgres:init": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode init --config .env.postgres --app-root .",
    "db:postgres:plan": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode plan --config .env.postgres --app-root . --dry-run",
    "check:app-composition": "node ../sdkwork-specs/tools/verify-repo.mjs --root .",
    "_sdkwork:build": "cargo build --workspace",
    "_sdkwork:test": "cargo test --workspace",
    "_sdkwork:check": "pnpm run check:app-composition && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && pnpm run db:validate",
    "_sdkwork:verify": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && pnpm run test:contract:database && pnpm run verify:rpc-proto && pnpm run test:topology-validate && pnpm run topology:matrix && pnpm run test:topology-baggage && pnpm run test:package-contract && pnpm run test:sdk-typescript-helpers && pnpm run test:docs-runbooks && pnpm run test:docs-canon && pnpm run verify:docs && pnpm run verify:sdk-rust && pnpm run verify:sdk-typescript && pnpm run check:app-composition",
    "_sdkwork:clean": "cargo clean && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev:standalone": "pnpm exec sdkwork-app dev --deployment-profile standalone",
    "release:package:standalone": "pnpm exec sdkwork-app release:package --deployment-profile standalone",
    "release:package:cloud": "pnpm exec sdkwork-app release:package --deployment-profile cloud",
    "release:validate:standalone": "pnpm exec sdkwork-app release:validate --deployment-profile standalone",
    "release:validate:cloud": "pnpm exec sdkwork-app release:validate --deployment-profile cloud",
    "api:assembly:materialize": "node ../sdkwork-specs/tools/materialize-api-assembly.mjs --root .",
    "api:assembly:validate": "node ../sdkwork-specs/tools/validate-api-assembly.mjs --root ."
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
