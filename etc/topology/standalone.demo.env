# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_discovery_demo`
# and a dedicated Redis logical DB index so no cache key ever collides with another shared-redis environment.
SDKWORK_DISCOVERY_DEPLOYMENT_PROFILE=standalone
SDKWORK_DISCOVERY_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_DISCOVERY_PROFILE_ID=standalone.demo
SDKWORK_DISCOVERY_APPLICATION_PUBLIC_HTTP_URL=https://discovery-demo.sdkwork.com
