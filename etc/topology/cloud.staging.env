# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_DISCOVERY_DEPLOYMENT_PROFILE=cloud
SDKWORK_DISCOVERY_ENVIRONMENT=staging
SDKWORK_DISCOVERY_PROFILE_ID=cloud.staging
SDKWORK_DISCOVERY_APPLICATION_PUBLIC_HTTP_URL=https://discovery-staging.sdkwork.com
SDKWORK_DISCOVERY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DISCOVERY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

