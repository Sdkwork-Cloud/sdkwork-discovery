# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_discovery_demo`
# and a dedicated Redis logical DB index so no cache key ever collides with another shared-redis environment.
SDKWORK_DISCOVERY_DEPLOYMENT_PROFILE=cloud
SDKWORK_DISCOVERY_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_DISCOVERY_PROFILE_ID=cloud.demo
SDKWORK_DISCOVERY_APPLICATION_PUBLIC_HTTP_URL=https://discovery-demo.sdkwork.com
SDKWORK_DISCOVERY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DISCOVERY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
