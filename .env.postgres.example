# SDKWork Discovery local PostgreSQL development profile.
# Copy this file to .env.postgres and change values for your local database.

SDKWORK_DISCOVERY_ENVIRONMENT=development
SDKWORK_DISCOVERY_CONFIG_PROFILE=dev
SDKWORK_DISCOVERY_DEPLOYMENT_MODE=server
SDKWORK_DISCOVERY_RUNTIME_TARGET=server
SDKWORK_DISCOVERY_STORAGE_PROVIDER=postgres
SDKWORK_DISCOVERY_DATABASE_ENGINE=postgresql
SDKWORK_DISCOVERY_DATABASE_HOST=127.0.0.1
SDKWORK_DISCOVERY_DATABASE_PORT=5432
SDKWORK_DISCOVERY_DATABASE_NAME=sdkwork_discovery
SDKWORK_DISCOVERY_DATABASE_SCHEMA=public
SDKWORK_DISCOVERY_DATABASE_USERNAME=sdkwork_discovery
SDKWORK_DISCOVERY_DATABASE_PASSWORD_FILE=secrets/postgres-password.txt
SDKWORK_DISCOVERY_DATABASE_SSL_MODE=disable
SDKWORK_DISCOVERY_DATABASE_CONNECT_TIMEOUT_MS=3000
SDKWORK_DISCOVERY_DATABASE_MAX_CONNECTIONS=16
SDKWORK_DISCOVERY_RPC_TLS_ENABLED=false
SDKWORK_DISCOVERY_RPC_MTLS_ENABLED=false
SDKWORK_DISCOVERY_RPC_REFLECTION_ENABLED=true
SDKWORK_DISCOVERY_RPC_HEALTH_ENABLED=true
