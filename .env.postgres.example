# SDKWork Discovery local PostgreSQL development profile.
# Copy this file to .env.postgres and change values for your local database.
#
# Unified workspace PostgreSQL profile. See sdkwork-specs/ENVIRONMENT_SPEC.md §7.1.

SDKWORK_DISCOVERY_ENVIRONMENT=development
SDKWORK_DISCOVERY_CONFIG_PROFILE=dev
SDKWORK_DISCOVERY_DEPLOYMENT_PROFILE=standalone
SDKWORK_DISCOVERY_RUNTIME_TARGET=server
SDKWORK_DISCOVERY_STORAGE_PROVIDER=postgres

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA_FALLBACK_PUBLIC=false
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/discovery/postgres-password
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=16
SDKWORK_DATABASE_ACQUIRE_TIMEOUT=3

SDKWORK_DATABASE_ADMIN_HOST=127.0.0.1
SDKWORK_DATABASE_ADMIN_PORT=5432
SDKWORK_DATABASE_ADMIN_USERNAME=postgres
SDKWORK_DATABASE_ADMIN_PASSWORD=postgres_admin_pass
SDKWORK_DATABASE_ADMIN_DATABASE=postgres
SDKWORK_DATABASE_ADMIN_SSL_MODE=disable

SDKWORK_DISCOVERY_RPC_TLS_ENABLED=false
SDKWORK_DISCOVERY_RPC_MTLS_ENABLED=false
SDKWORK_DISCOVERY_RPC_REFLECTION_ENABLED=true
SDKWORK_DISCOVERY_RPC_HEALTH_ENABLED=true
