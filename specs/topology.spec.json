{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-discovery",
  "applicationCode": "discovery",
  "archetype": "application-http-gateway",
  "archetypeNotes": "Discovery surfaces are gRPC-only (application.public-ingress, operations.control-ingress), not HTTP. sdkwork-web-framework is not required because this app owns no HTTP *-api surfaces.",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production",
        "demo"
      ]
    },
    "connectivityPlane": {
      "allowed": [
        "application",
        "operations"
      ]
    },
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "desktopBuildProfileId": "standalone.production"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.production": "etc/topology/cloud.production.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "standalone.demo": "etc/topology/standalone.demo.env",
    "cloud.demo": "etc/topology/cloud.demo.env"
  },
  "envKeys": {
    "environment": "SDKWORK_DISCOVERY_ENVIRONMENT",
    "profileId": "SDKWORK_DISCOVERY_PROFILE_ID",
    "deploymentProfile": "SDKWORK_DISCOVERY_DEPLOYMENT_PROFILE"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "grpc"
      ],
      "bindEnv": "SDKWORK_DISCOVERY_APPLICATION_PUBLIC_INGRESS_BIND",
      "grpcUrlEnv": "SDKWORK_DISCOVERY_APPLICATION_PUBLIC_GRPC_URL"
    },
    "operations.control-ingress": {
      "connectivityPlane": "operations",
      "protocols": [
        "grpc"
      ],
      "bindEnv": "SDKWORK_DISCOVERY_OPERATIONS_CONTROL_INGRESS_BIND",
      "grpcUrlEnv": "SDKWORK_DISCOVERY_OPERATIONS_CONTROL_GRPC_URL",
      "optional": true
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_DISCOVERY_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_DISCOVERY_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "cloudPublicHosts": {
    "platform.api-gateway": {
      "httpHost": "api.sdkwork.com",
      "environments": {
        "development": {
          "httpHosts": [
            "api-dev.sdkwork.com",
            "api-dev.birdcoder.com",
            "api-dev.dtupay.com",
            "api-dev.sdkwork.cn",
            "api-dev.birdcoder.cn",
            "api-dev.dtupay.cn",
            "api-dev.skubc.com",
            "api-dev.skubc.cn",
            "api-dev.zowalk.com",
            "api-dev.zowalk.cn",
            "api-dev.offer86.com",
            "api-dev.offer86.cn",
            "api-dev.86offer.com",
            "api-dev.86offer.cn"
          ]
        },
        "test": {
          "httpHosts": [
            "api-test.sdkwork.com",
            "api-test.birdcoder.com",
            "api-test.dtupay.com",
            "api-test.sdkwork.cn",
            "api-test.birdcoder.cn",
            "api-test.dtupay.cn",
            "api-test.skubc.com",
            "api-test.skubc.cn",
            "api-test.zowalk.com",
            "api-test.zowalk.cn",
            "api-test.offer86.com",
            "api-test.offer86.cn",
            "api-test.86offer.com",
            "api-test.86offer.cn"
          ]
        },
        "staging": {
          "httpHosts": [
            "api-staging.sdkwork.com",
            "api-staging.birdcoder.com",
            "api-staging.dtupay.com",
            "api-staging.sdkwork.cn",
            "api-staging.birdcoder.cn",
            "api-staging.dtupay.cn",
            "api-staging.skubc.com",
            "api-staging.skubc.cn",
            "api-staging.zowalk.com",
            "api-staging.zowalk.cn",
            "api-staging.offer86.com",
            "api-staging.offer86.cn",
            "api-staging.86offer.com",
            "api-staging.86offer.cn"
          ]
        },
        "demo": {
          "httpHosts": [
            "api-demo.sdkwork.com",
            "api-demo.birdcoder.com",
            "api-demo.dtupay.com",
            "api-demo.sdkwork.cn",
            "api-demo.birdcoder.cn",
            "api-demo.dtupay.cn",
            "api-demo.skubc.com",
            "api-demo.skubc.cn",
            "api-demo.zowalk.com",
            "api-demo.zowalk.cn",
            "api-demo.offer86.com",
            "api-demo.offer86.cn",
            "api-demo.86offer.com",
            "api-demo.86offer.cn"
          ]
        }
      },
      "httpHosts": [
        "api.sdkwork.com",
        "api.birdcoder.com",
        "api.dtupay.com",
        "api.sdkwork.cn",
        "api.birdcoder.cn",
        "api.dtupay.cn",
        "api.skubc.com",
        "api.skubc.cn",
        "api.zowalk.com",
        "api.zowalk.cn",
        "api.offer86.com",
        "api.offer86.cn",
        "api.86offer.com",
        "api.86offer.cn"
      ]
    }
  },
  "components": {
    "serviceHost": {
      "crate": "sdkwork-discovery-service-host",
      "binary": "sdkwork-discovery-service-host"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-discovery-service-host",
            "binary": "sdkwork-discovery-service-host",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.development": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "standalone.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-discovery-service-host",
            "binary": "sdkwork-discovery-service-host",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-discovery-service-host",
            "binary": "sdkwork-discovery-service-host",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.test": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-discovery-service-host",
            "binary": "sdkwork-discovery-service-host",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.staging": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-discovery-service-host",
            "binary": "sdkwork-discovery-service-host",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.test": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.staging": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-discovery-service-host",
            "binary": "sdkwork-discovery-service-host",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.demo": {
        "processes": [],
        "healthSurfaces": []
      },
      "cloud.demo": {
        "processes": [],
        "healthSurfaces": []
      }
    }
  },
  "runtime": {
    "supportedDeploymentProfiles": [
      "cloud"
    ],
    "deliveryModes": [
      "DIRECT_DOWNLOAD"
    ],
    "runtimeTarget": "server"
  },
  "packaging": {
    "targets": [
      {
        "id": "linux-x64-cloud-server-tar-gz",
        "profile": "server",
        "platform": "linux",
        "architecture": "x64",
        "formats": [
          "tar.gz"
        ],
        "runner": "ubuntu-24.04",
        "rustTarget": "x86_64-unknown-linux-gnu",
        "outputGlob": "dist/server/sdkwork-discovery-*-linux-x64-server.tar.gz"
      }
    ],
    "cloudConfigFiles": []
  },
  "scripts": {
    "discoveryDev": "scripts/discovery-dev.mjs",
    "pnpm": {
      "dev": {
        "script": "dev",
        "deploymentProfile": "standalone",
        "target": "server"
      },
      "dev:cloud": {
        "script": "dev:cloud",
        "deploymentProfile": "cloud",
        "target": "server"
      },
      "topology:validate": {
        "script": "topology:validate",
        "command": "sdkwork-topology validate"
      },
      "topology:matrix": {
        "script": "topology:matrix",
        "command": "sdkwork-topology print-matrix --profile all"
      }
    }
  },
  "retired": {
    "envKeys": [
      "SDKWORK_DISCOVERY_TOPOLOGY",
      "SDKWORK_DISCOVERY_GRPC_BIND_HOST",
      "SDKWORK_DISCOVERY_GRPC_PORT",
      "SDKWORK_DISCOVERY_ADMIN_GRPC_PORT",
      "SDKWORK_DISCOVERY_HOSTING",
      "SDKWORK_DISCOVERY_DEPLOYMENT_MODE"
    ],
    "notes": "Legacy grpc bind env keys were removed; use application.public-ingress and operations.control-ingress surface bind keys.",
    "vocabulary": {
      "hosting": [
        "self-hosted",
        "cloud-hosted"
      ]
    }
  }
}
