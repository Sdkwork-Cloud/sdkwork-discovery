# Discovery topology profile: self-hosted + unified-process + production

SDKWORK_DISCOVERY_HOSTING=self-hosted
SDKWORK_DISCOVERY_SERVICE_LAYOUT=unified-process
SDKWORK_DISCOVERY_ENVIRONMENT=production
SDKWORK_DISCOVERY_PROFILE_ID=self-hosted.unified-process.production
SDKWORK_DISCOVERY_CONFIG_PROFILE=prod
SDKWORK_DISCOVERY_DEPLOYMENT_MODE=server
SDKWORK_DISCOVERY_RUNTIME_TARGET=server

SDKWORK_DISCOVERY_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:19090
SDKWORK_DISCOVERY_APPLICATION_PUBLIC_GRPC_URL=grpcs://discovery.internal:19090

SDKWORK_DISCOVERY_OPERATIONS_CONTROL_INGRESS_BIND=0.0.0.0:19091
SDKWORK_DISCOVERY_OPERATIONS_CONTROL_GRPC_URL=grpcs://discovery.internal:19091

# Release server packages enable the prometheus feature. Bind on all interfaces for in-cluster scraping.
SDKWORK_DISCOVERY_METRICS_BIND=0.0.0.0:9090
