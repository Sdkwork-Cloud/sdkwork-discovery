# Discovery topology profile: cloud-hosted + unified-process + production

SDKWORK_DISCOVERY_HOSTING=cloud-hosted
SDKWORK_DISCOVERY_SERVICE_LAYOUT=unified-process
SDKWORK_DISCOVERY_ENVIRONMENT=production
SDKWORK_DISCOVERY_PROFILE_ID=cloud-hosted.unified-process.production
SDKWORK_DISCOVERY_CONFIG_PROFILE=prod
SDKWORK_DISCOVERY_DEPLOYMENT_MODE=container
SDKWORK_DISCOVERY_RUNTIME_TARGET=container

SDKWORK_DISCOVERY_APPLICATION_PUBLIC_GRPC_URL=grpcs://discovery.sdkwork.com:443

SDKWORK_DISCOVERY_OPERATIONS_CONTROL_GRPC_URL=grpcs://discovery-admin.sdkwork.com:443
